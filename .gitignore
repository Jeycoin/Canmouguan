# ---- 依赖与构建产物 ----
node_modules/
dist/
dist-electron/
.vite/

# ---- 打包产物（release/ release-build/ release-dc*/ release-ship/ …）----
release/
release-*/
*.exe
*.blockmap

# ---- 本地环境与密钥（server/.gitignore 另有 .env / data/ 兜底）----
.env
server/.env
server/data/

# ---- 日志与临时产物 ----
*.log
.DS_Store
Thumbs.db
smoke.png
smoke-settings.png
# 探针截图不入库；_probe/*.html 与 *.js 是可复用的对比脚本，保留
_probe/*.png

