# 「参谋官」云端网关 · 环境变量
#
# 复制成 .env 后填真实值：cp .env.example .env
# ⚠️ .env 和 data/ 都不要提交到任何仓库（已写进 .gitignore）

# ── 监听 ────────────────────────────────────────────────────────────
# 本机调试用 127.0.0.1；部署到服务器时改 0.0.0.0，前面挂 Nginx 做 TLS
CMG_HOST=127.0.0.1
CMG_PORT=8787

# ── 上游密钥（只存在这台机器上，客户端永远拿不到）────────────────────
# 阿里云百炼（语音识别）
CMG_DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 大模型（智谱 open.bigmodel.cn，OpenAI 兼容端点）
CMG_LLM_API_KEY=xxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxx
CMG_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
CMG_LLM_MODEL=glm-4-flash
CMG_LLM_VISION_MODEL=glm-4v-flash

# ── 签名密钥 ────────────────────────────────────────────────────────
# 留空则自动生成并存到 data/gateway.secret。
# 多实例部署时**必须**显式设置成同一个值，否则两个实例签的 token 互不认。
# CMG_GATEWAY_SECRET=

# ── 注册控制（内测建议：关闭自助注册，只让有码的人进来）────────────────
CMG_ALLOW_SELF_REGISTER=1
# CMG_REGISTER_INVITE_CODE=内测邀请码

# ── 短信通道（手机号注册/登录用）──────────────────────────────────────
# console = 验证码只打印在网关日志里，本机自测够用。
# ⚠️ 生产环境（NODE_ENV=production）会自动拒绝 console 通道：
#    把登录验证码写进日志 = 任何能看到日志的人都能登录任意账号。
#    确实只在受控环境跑，才用 CMG_SMS_ALLOW_CONSOLE=1 显式放行。
CMG_SMS_PROVIDER=console
# CMG_SMS_ALLOW_CONSOLE=1

# webhook = 把 {phone, code, purpose, expiresInMinutes} POST 给你自己的适配器，
# 由它去调阿里云/腾讯云短信。换服务商不用改网关代码。
# CMG_SMS_PROVIDER=webhook
# CMG_SMS_WEBHOOK_URL=http://127.0.0.1:9000/sms
# CMG_SMS_WEBHOOK_TOKEN=

# 验证码策略
CMG_SMS_TTL_MINUTES=5
CMG_SMS_MAX_ATTEMPTS=5
CMG_SMS_RESEND_SECONDS=60
# 单号码 / 单 IP 每小时的发送上限（短信要花钱，这是成本闸门）
CMG_SMS_PER_HOUR=5
CMG_SMS_PER_HOUR_IP=20

# ── 商店信息（购买指引，服务端下发给客户端）──────────────────────────
# ⚠️ 这些值**必须在这里配**，别写进客户端：改价格/换购买链接/换客服微信
#    都不该逼用户重新下载客户端（何况现在还没有自动更新通道）。
# 至少配一项，否则客户端会显示"暂无购买渠道"。
CMG_STORE_URL=https://canmouguan.cloud
CMG_STORE_WECHAT=
CMG_STORE_QQ=
CMG_STORE_EMAIL=
# 直接展示给用户的购买说明
CMG_STORE_NOTE=拍下后备注手机号，5 分钟内发码

# 各套餐售价（元），仅用于展示 —— 网关不参与收款
CMG_PRICE_TRIAL7=0
CMG_PRICE_MONTH=49
CMG_PRICE_QUARTER=129
CMG_PRICE_YEAR=399

# ── 发卡平台回调（自动发码）──────────────────────────────────────────
# 收银台放在发卡平台，网关只做"收到付款通知 → 现场签发兑换码 → 返回给平台展示"。
#
# ⚠️ **默认关闭**：CMG_PAYHOOK_TOKEN 留空则该端点返回 503。
#    这个端点能在没有任何账号的前提下凭空发会员，配了强随机 token 再开启。
# CMG_PAYHOOK_TOKEN=换成一串足够长的随机值
#
# 平台商品 ID → 兑换码类型 的映射（平台商品改名只改这里，不动代码）。
# 若平台直接把 month / quarter / year / trial7 当商品 ID 传，不配也能用。
# CMG_PAYHOOK_PRODUCTS=sku-abc123=month,sku-def456=year
# 单次回调最多签发几个码（防伪造请求一次薅走一批会员）
CMG_PAYHOOK_MAX_COUNT=20

# 回调地址（填到发卡平台后台）：
#   POST https://你的域名/api/hook/card?token=<CMG_PAYHOOK_TOKEN>
# 鉴权也支持 Authorization: Bearer <token>；平台只能填 URL 时用上面的查询参数形式。
# 建议同时在 Nginx 限制调用来源 IP。

# ── 套餐额度（改这里就等于改定价结构，改前先算成本，见 README）──────────
# 免费体验：30 分钟语音 + 50 次提问（一次性，永不清零）
CMG_FREE_ASR_SECONDS=1800
CMG_FREE_LLM_CALLS=50
# 专业版（按月重置）：20 小时语音 + 2000 次提问
CMG_PRO_ASR_SECONDS=72000
CMG_PRO_LLM_CALLS=2000

# ── 可调项 ──────────────────────────────────────────────────────────
# token 有效期（天）
CMG_TOKEN_TTL_DAYS=30
# 单次文件转写请求体上限（字节），默认 20MB ≈ 10 分钟 16k 单声道 PCM
CMG_MAX_UPLOAD_BYTES=20971520
